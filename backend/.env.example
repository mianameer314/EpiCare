[TEMPLATE]
# EpiCare Backend — Environment Variables
# Copy to backend/.env and fill values. Never commit .env.
# All values are read by app/core/config.py (pydantic-settings).

# ============================
# Application Config
# ============================
APP_NAME="EpiCare AI"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ============================
# Database Configuration
# ============================
DATABASE_URL=postgresql://postgres:HEHE@localhost:5432/KUCH B
REDIS_URL=redis://localhost:6379

# ============================
# JWT Authentication
# ============================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# ==========================================================
# Email / Mailer
# ==========================================================
MAIL_USERNAME=mianameer830@gmail.com
MAIL_PASSWORD=
MAIL_FROM=mianameer830@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=EpiCare
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ============================
# CORS
# ============================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173

# ============================
# Storage (Local during FYP, s3 later)
# ============================
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=storage
EEG_MAX_SIZE_MB=200
ALLOWED_EEG_EXTENSIONS=.edf,.csv

# ============================
# AWS S3 (only when STORAGE_PROVIDER=s3)
# ============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=

# ============================
# Model Registry
# ============================
MODEL_ROOT=models/seizure_detector
MODEL_NAME=EpiCareFusion

# ============================
# AI / LLM (OpenAI-compatible; report + RAG)
# ============================
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ============================
# Emergency SOS
# ============================
SOS_PROVIDER=firebase  # 'email', 'firebase', 'whatsapp', or 'twilio'

# Firebase Admin SDK (server-side push + SOS alerts)
# Download service account JSON from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Firebase Web Push (client-side FCM token registration — from Firebase Console > Project Settings > Web app)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Twilio (Legacy/Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================
# Background Jobs
# ============================
SCHEDULER_ENABLED=true
